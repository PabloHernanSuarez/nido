{% extends 'base.html.twig' %}

{% block body %}
    {% set usuario = app.user %}
    <h1 class="mb-1">{{ saludo() }}, {{ usuario.nombre }}</h1>
    <p class="nido-subtitulo">
        {{ date()|fecha_larga }}
        {% if is_granted('ROLE_DIRECTORA') %} · Panel de dirección{% endif %}
    </p>

    <div class="row g-3 mt-1">
        {% if is_granted('ROLE_USUARIO_VER') %}
            <div class="col-sm-6 col-lg-4">
                <a class="card nido-acceso h-100" href="{{ path('app_usuario_index') }}">
                    <div class="card-body">
                        <span class="nido-acceso-icono mb-2"><i class="bi bi-people"></i></span>
                        <h2 class="h5 mb-1">Usuarios</h2>
                        <p class="small text-secondary mb-0">El equipo del jardín y las familias, con su acceso.</p>
                    </div>
                </a>
            </div>
        {% endif %}
        {% if is_granted('ROLE_JARDIN_VER') %}
            <div class="col-sm-6 col-lg-4">
                <a class="card nido-acceso h-100" href="{{ path('app_jardin_index') }}">
                    <div class="card-body">
                        <span class="nido-acceso-icono mb-2"><i class="bi bi-house-heart"></i></span>
                        <h2 class="h5 mb-1">Jardines</h2>
                        <p class="small text-secondary mb-0">El espacio de cada jardín, con su logo y sus colores.</p>
                    </div>
                </a>
            </div>
        {% endif %}
        <div class="col-sm-6 col-lg-4">
            <a class="card nido-acceso h-100" href="{{ path('app_usuario_cambiar_password') }}">
                <div class="card-body">
                    <span class="nido-acceso-icono mb-2"><i class="bi bi-key"></i></span>
                    <h2 class="h5 mb-1">Mi contraseña</h2>
                    <p class="small text-secondary mb-0">Cambiá la contraseña con la que entrás.</p>
                </div>
            </a>
        </div>
    </div>
{% endblock %}
