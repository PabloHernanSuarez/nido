{% extends 'base.html.twig' %}

{% block title %}{{ titulo }} · Nido{% endblock %}

{% block body %}
    <div class="mx-auto" style="max-width: 560px">
        <h1 class="mb-3">{{ titulo }}</h1>
        <div class="card">
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="row">
                        <div class="col-sm-6">{{ form_row(form.nombre) }}</div>
                        <div class="col-sm-6">{{ form_row(form.apellido) }}</div>
                    </div>
                    {{ form_rest(form) }}
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-nido">Guardar</button>
                        <a href="{{ path('app_usuario_index') }}" class="btn btn-outline-primary">Cancelar</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
