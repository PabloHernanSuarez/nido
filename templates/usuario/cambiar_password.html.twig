{% extends 'base.html.twig' %}

{% block title %}Cambiar contraseña · Nido{% endblock %}

{% block body %}
    <div class="mx-auto" style="max-width: 460px">
        <h1 class="mb-1">Cambiar contraseña</h1>
        {% if primerIngreso %}
            <p class="nido-subtitulo">Es tu primer ingreso: elegí una contraseña tuya para seguir.</p>
        {% endif %}
        <div class="card mt-3">
            <div class="card-body p-4">
                {{ form_start(form) }}
                    {% if form.currentPassword is defined %}{{ form_row(form.currentPassword) }}{% endif %}
                    {{ form_row(form.plainPassword) }}
                    <button class="btn btn-nido w-100" type="submit">Guardar contraseña</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
